# Raspberry Pi SSH connection details (optional, for remote deployment scripts)
RASPBERRY_PI_HOST=192.168.1.100
RASPBERRY_PI_USER=root
RASPBERRY_PI_PASSWORD=your_password_here

# Local Modrinth instance directories (optional, for pack export scripts)
MINECRAFT_CLIENT_FILES="/path/to/Modrinth/profiles/Fabric-Client"
MINECRAFT_SERVER_FILES="/path/to/Modrinth/profiles/Fabric-Server"
